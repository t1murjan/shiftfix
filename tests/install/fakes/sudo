#!/bin/bash
# Журнал вызовов sudo. Пакетные менеджеры только пишутся в журнал: ставить пакеты в
# систему стенду незачем. Остальное — настоящий sudo (у тестового пользователя NOPASSWD).
# ~/.fakesd/no-sudo — прав нет: любой вызов падает, как у пользователя не из sudoers.
mkdir -p "$HOME/log"
echo "$*" >>"$HOME/log/sudo.log"
if [[ -e $HOME/.fakesd/no-sudo ]]; then
    echo "sudo: нет прав (стенд)" >&2
    exit 1
fi
case $1 in
pacman | apt-get | apt | dnf | yum | zypper | rpm-ostree | apk | xbps-install | emerge) exit 0 ;;
esac
exec /usr/bin/sudo "$@"
